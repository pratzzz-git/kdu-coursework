# -------- ROOT QUERY --------
type Query {
  findMovieById(id: ID!): Movie
}

# -------- ROOT MUTATION --------
type Mutation {
  addReview(movieId: ID!, comment: String!, rating: Int!): Movie
}

# -------- TYPES --------
type Movie {
  id: ID!
  title: String!
  genre: String!
  director: Director
  reviews: [Review]
}

type Director {
  id: ID!
  name: String!
  totalAwards: Int!
}

type Review {
  comment: String!
  rating: Int!
}
